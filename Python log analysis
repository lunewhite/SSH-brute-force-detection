import re
from collections import Counter
import matplotlib.pyplot as plt

log_file = "/var/log/auth.log"
pattern = re.compile(r"Failed password for (?:invalid user )?(\S+) from (\S+)")

ip_counter = Counter()
user_counter = Counter()

with open(log_file, "r") as f:
    for line in f:
        match = pattern.search(line)
        if match:
            user, ip = match.groups()
            user_counter[user] += 1
            ip_counter[ip] += 1

print("Top attacking IPs:")
for ip, count in ip_counter.most_common(5):
    print(f"  {ip}: {count} failed attempts")

print("\nTop targeted usernames:")
for user, count in user_counter.most_common(5):
    print(f"  {user}: {count} failed attempts")

# Chart
plt.bar(ip_counter.keys(), ip_counter.values(), color="crimson")
plt.title("Failed SSH Login Attempts by Source IP")
plt.xlabel("Source IP")
plt.ylabel("Failed Attempts")
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig("ssh_attack_report.png")
print("\nChart saved as ssh_attack_report.png")